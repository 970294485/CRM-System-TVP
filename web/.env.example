# Neon — paste from Neon Dashboard → Connection details (pooled URI recommended for serverless).
# Copy this file to ".env.local" and replace with your real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth.js — generate with: openssl rand -base64 32 (Vercel: same names in Production env, then redeploy)
AUTH_SECRET="replace-with-random-secret-at-least-32-chars"

# After npm run db:seed with zero users, default login is admin@example.com / admin — change in production.
